package templates

type ForgotData struct {
	CSRFToken   string
	CSPNonce    string
	GenericSent bool
}

templ ForgotPage(data ForgotData) {
	@Layout("Forgot password", data.CSPNonce) {
		<main class="mx-auto max-w-md px-6 py-12">
			<h1 class="text-2xl font-semibold mb-6">Forgot your password?</h1>
			if data.GenericSent {
				<div class="rounded border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-800">
					If an account with that email exists, a reset link was sent. Check your inbox.
				</div>
				<p class="mt-6 text-sm text-zinc-600">
					<a href="/login" class="underline">Back to log in</a>
				</p>
			} else {
				<p class="mb-4 text-sm text-zinc-600">Enter your email and we'll send you a reset link.</p>
				<form method="post" action="/forgot-password" class="space-y-4">
					<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
					<label class="block">
						<span class="text-sm font-medium">Email</span>
						<input type="email" name="email" required autofocus class="mt-1 block w-full rounded border-zinc-300 px-3 py-2"/>
					</label>
					<button type="submit" class="w-full rounded bg-zinc-900 px-4 py-2 text-white hover:bg-zinc-800">Send reset link</button>
				</form>
			}
		</main>
	}
}
