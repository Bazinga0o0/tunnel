package templates

type SettingsData struct {
	Email     string
	Changed   bool
	ErrMsg    string
	CSRFToken string
	CSPNonce  string
}

templ SettingsPage(data SettingsData) {
	@Layout("Settings", data.CSPNonce) {
		<main class="mx-auto max-w-2xl px-6 py-12">
			<header class="mb-8 flex items-center justify-between">
				<h1 class="text-2xl font-semibold">Settings</h1>
				<a href="/dashboard" class="text-sm underline">← Dashboard</a>
			</header>
			if data.Changed {
				<div class="mb-6 rounded border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-800">
					Password changed. All other sessions were signed out.
				</div>
			}
			<section class="mb-8 rounded border border-zinc-200 bg-white p-5">
				<div class="text-sm font-medium text-zinc-600">Email</div>
				<div class="mt-1 font-mono text-sm">{ data.Email }</div>
			</section>
			<section class="rounded border border-zinc-200 bg-white p-5">
				<h2 class="mb-4 text-lg font-semibold">Change password</h2>
				if data.ErrMsg != "" {
					<div class="mb-4 rounded bg-red-100 px-4 py-3 text-sm text-red-800">{ data.ErrMsg }</div>
				}
				<form method="post" action="/settings/password" class="space-y-4">
					<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
					<label class="block">
						<span class="text-sm font-medium">Current password</span>
						<input type="password" name="current" required class="mt-1 block w-full rounded border-zinc-300 px-3 py-2"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium">New password</span>
						<input type="password" name="new" required minlength="8" class="mt-1 block w-full rounded border-zinc-300 px-3 py-2"/>
					</label>
					<label class="block">
						<span class="text-sm font-medium">Confirm new password</span>
						<input type="password" name="confirm" required minlength="8" class="mt-1 block w-full rounded border-zinc-300 px-3 py-2"/>
					</label>
					<button type="submit" class="rounded bg-zinc-900 px-4 py-2 text-white hover:bg-zinc-800">Update password</button>
				</form>
			</section>
		</main>
	}
}
