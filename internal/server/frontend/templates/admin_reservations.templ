package templates

import (
	"fmt"
	"net/url"
	"time"

	"github.com/Bazinga0o0/tunnel/internal/server/db/sqlcgen"
)

// AdminReservationsData is the view model for /admin/reservations.
type AdminReservationsData struct {
	ActiveTab  string // "subdomain", "tcp", "udp"
	CSRFToken  string
	CSPNonce   string
	ErrorMsg   string

	Subdomains []SubdomainReservationRow
	TCPPorts   []PortReservationRow
	UDPPorts   []PortReservationRow
}

// SubdomainReservationRow is one row in the subdomains table.
type SubdomainReservationRow struct {
	Subdomain  string
	OwnerEmail string
	CreatedAt  time.Time
}

// PortReservationRow is one row in the TCP/UDP tables.
type PortReservationRow struct {
	Port       int32
	OwnerEmail string
	CreatedAt  time.Time
}

// AdminReservationsPageFromRaw builds AdminReservationsData populating display
// rows from raw sqlcgen types and an email lookup map.
func AdminReservationsPageFromRaw(
	tab string,
	csrfToken, nonce, errMsg string,
	sds []sqlcgen.ReservedSubdomain,
	tcps []sqlcgen.ReservedTcpPort,
	udps []sqlcgen.ReservedUdpPort,
	emails map[int64]string,
) AdminReservationsData {
	d := AdminReservationsData{
		ActiveTab: tab,
		CSRFToken: csrfToken,
		CSPNonce:  nonce,
		ErrorMsg:  errMsg,
	}
	for _, s := range sds {
		email := emails[s.UserID]
		if email == "" {
			email = fmt.Sprintf("uid:%d", s.UserID)
		}
		d.Subdomains = append(d.Subdomains, SubdomainReservationRow{
			Subdomain:  s.Subdomain,
			OwnerEmail: email,
			CreatedAt:  s.CreatedAt.Time,
		})
	}
	for _, p := range tcps {
		email := emails[p.UserID]
		if email == "" {
			email = fmt.Sprintf("uid:%d", p.UserID)
		}
		d.TCPPorts = append(d.TCPPorts, PortReservationRow{
			Port:       p.Port,
			OwnerEmail: email,
			CreatedAt:  p.CreatedAt.Time,
		})
	}
	for _, p := range udps {
		email := emails[p.UserID]
		if email == "" {
			email = fmt.Sprintf("uid:%d", p.UserID)
		}
		d.UDPPorts = append(d.UDPPorts, PortReservationRow{
			Port:       p.Port,
			OwnerEmail: email,
			CreatedAt:  p.CreatedAt.Time,
		})
	}
	return d
}

templ AdminReservationsPage(data AdminReservationsData) {
	@AdminLayout("Reservations", data.CSPNonce, "reservations") {
		<main class="mx-auto max-w-5xl px-6 py-12">
			<h1 class="text-2xl font-semibold mb-6">Reservations</h1>
			if data.ErrorMsg != "" {
				<div class="mb-4 rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-700">{ data.ErrorMsg }</div>
			}
			<!-- Grant form -->
			<details class="mb-8 rounded border border-zinc-200 bg-white">
				<summary class="cursor-pointer px-4 py-3 text-sm font-medium text-zinc-700 hover:bg-zinc-50">Grant a reservation</summary>
				<div class="px-4 py-4 border-t border-zinc-100">
					<form method="POST" action="/admin/reservations/grant" class="flex flex-wrap gap-4 items-end text-sm">
						<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
						<div>
							<label class="block text-xs text-zinc-500 mb-1">Type</label>
							<select name="type" class="rounded border border-zinc-300 px-3 py-2">
								<option value="subdomain" selected?={ data.ActiveTab == "subdomain" }>Subdomain</option>
								<option value="tcp" selected?={ data.ActiveTab == "tcp" }>TCP port</option>
								<option value="udp" selected?={ data.ActiveTab == "udp" }>UDP port</option>
							</select>
						</div>
						<div>
							<label class="block text-xs text-zinc-500 mb-1">Key (subdomain or port number)</label>
							<input type="text" name="key" required class="rounded border border-zinc-300 px-3 py-2 w-48" placeholder="e.g. myapp or 8080"/>
						</div>
						<div>
							<label class="block text-xs text-zinc-500 mb-1">User email</label>
							<input type="email" name="email" required class="rounded border border-zinc-300 px-3 py-2 w-56" placeholder="user@example.com"/>
						</div>
						<button type="submit" class="rounded bg-zinc-800 px-4 py-2 text-white hover:bg-zinc-900">Grant</button>
					</form>
				</div>
			</details>
			<!-- Tab navigation -->
			<div class="flex gap-1 border-b border-zinc-200 mb-6 text-sm">
				@reservationTabLink("subdomain", "Subdomains", data.ActiveTab)
				@reservationTabLink("tcp", "TCP Ports", data.ActiveTab)
				@reservationTabLink("udp", "UDP Ports", data.ActiveTab)
			</div>
			<!-- Active tab content -->
			if data.ActiveTab == "tcp" {
				@reservationPortTable(data.TCPPorts, "tcp", data.CSRFToken)
			} else if data.ActiveTab == "udp" {
				@reservationPortTable(data.UDPPorts, "udp", data.CSRFToken)
			} else {
				@reservationSubdomainTable(data.Subdomains, data.CSRFToken)
			}
		</main>
	}
}

templ reservationTabLink(tab, label, activeTab string) {
	if tab == activeTab {
		<span class="px-4 py-2 font-medium text-zinc-900 border-b-2 border-zinc-900">{ label }</span>
	} else {
		<a href={ templ.SafeURL("?tab=" + tab) } class="px-4 py-2 text-zinc-500 hover:text-zinc-900">{ label }</a>
	}
}

templ reservationSubdomainTable(rows []SubdomainReservationRow, csrfToken string) {
	if len(rows) == 0 {
		<p class="text-sm text-zinc-500">No subdomain reservations.</p>
	} else {
		<table class="w-full text-sm border border-zinc-200 rounded bg-white">
			<thead class="bg-zinc-50 text-left text-xs uppercase text-zinc-500">
				<tr>
					<th class="px-4 py-2 font-medium">Owner</th>
					<th class="px-4 py-2 font-medium">Subdomain</th>
					<th class="px-4 py-2 font-medium">Created</th>
					<th class="px-4 py-2"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-zinc-100">
				for _, row := range rows {
					<tr>
						<td class="px-4 py-2 font-mono text-xs">{ row.OwnerEmail }</td>
						<td class="px-4 py-2 font-mono text-xs">{ row.Subdomain }</td>
						<td class="px-4 py-2 text-zinc-500">{ row.CreatedAt.Format("2006-01-02") }</td>
						<td class="px-4 py-2 text-right">
							@reservationRevokeForm("subdomain", row.Subdomain, csrfToken)
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ reservationPortTable(rows []PortReservationRow, portType string, csrfToken string) {
	if len(rows) == 0 {
		<p class="text-sm text-zinc-500">No { portType } port reservations.</p>
	} else {
		<table class="w-full text-sm border border-zinc-200 rounded bg-white">
			<thead class="bg-zinc-50 text-left text-xs uppercase text-zinc-500">
				<tr>
					<th class="px-4 py-2 font-medium">Owner</th>
					<th class="px-4 py-2 font-medium">Port</th>
					<th class="px-4 py-2 font-medium">Created</th>
					<th class="px-4 py-2"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-zinc-100">
				for _, row := range rows {
					<tr id={ fmt.Sprintf("res-%s-%d", portType, row.Port) }>
						<td class="px-4 py-2 font-mono text-xs">{ row.OwnerEmail }</td>
						<td class="px-4 py-2 font-mono text-xs">{ fmt.Sprint(row.Port) }</td>
						<td class="px-4 py-2 text-zinc-500">{ row.CreatedAt.Format("2006-01-02") }</td>
						<td class="px-4 py-2 text-right">
							@reservationRevokeForm(portType, fmt.Sprint(row.Port), csrfToken)
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// reservationRevokeURL is the URL the revoke form for a reservation of type
// resType posts to. The type is path-escaped; the reservation's key (a
// subdomain or a port) travels in the form body and never in the URL, so a
// stored name cannot change the target of the form.
func reservationRevokeURL(resType string) string {
	return "/admin/reservations/" + url.PathEscape(resType) + "/revoke"
}

// reservationRevokeForm is the revoke button of one reservation row. It swaps
// out the row it sits in.
templ reservationRevokeForm(resType, key, csrfToken string) {
	<form
		method="POST"
		action={ templ.SafeURL(reservationRevokeURL(resType)) }
		hx-post={ reservationRevokeURL(resType) }
		hx-target="closest tr"
		hx-swap="outerHTML"
		hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }
	>
		<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
		<input type="hidden" name="key" value={ key }/>
		<button type="submit" class="text-xs text-red-600 hover:underline">Revoke</button>
	</form>
}
