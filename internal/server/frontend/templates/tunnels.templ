package templates

import (
	"fmt"
	"time"
)

type TunnelRow struct {
	Subdomain string
	PublicURL string
	Connected time.Time
}

type TunnelsData struct {
	Domain   string
	CSPNonce string
}

templ TunnelsPage(data TunnelsData) {
	@Layout("Live tunnels", data.CSPNonce) {
		<main class="mx-auto max-w-4xl px-6 py-12">
			<header class="mb-8 flex items-center justify-between">
				<h1 class="text-2xl font-semibold">Live tunnels</h1>
				<a href="/dashboard" class="text-sm underline">← Dashboard</a>
			</header>
			<div id="tunnels-table"
				hx-get="/tunnels/status"
				hx-trigger="load, every 3s"
				hx-swap="innerHTML">
				<p class="text-zinc-500">Loading…</p>
			</div>
		</main>
	}
}

// TunnelsFragment is what hx-get /tunnels/status returns — inner HTML only.
templ TunnelsFragment(rows []TunnelRow, now time.Time) {
	if len(rows) == 0 {
		<p class="text-zinc-500">No live tunnels right now. Run <code class="rounded bg-zinc-100 px-1 font-mono">tunnel http &lt;port&gt;</code> on your laptop to open one.</p>
	} else {
		<table class="w-full text-left text-sm">
			<thead class="border-b border-zinc-200 text-xs uppercase text-zinc-500">
				<tr>
					<th class="py-2">Subdomain</th>
					<th class="py-2">Public URL</th>
					<th class="py-2">Uptime</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr class="border-b border-zinc-100">
						<td class="py-2 font-mono">{ r.Subdomain }</td>
						<td class="py-2"><a href={ templ.SafeURL(r.PublicURL) } class="underline">{ r.PublicURL }</a></td>
						<td class="py-2 text-zinc-600">{ formatUptime(now.Sub(r.Connected)) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

func formatUptime(d time.Duration) string {
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm %ds", int(d.Minutes()), int(d.Seconds())%60)
	}
	return fmt.Sprintf("%dh %dm", int(d.Hours()), int(d.Minutes())%60)
}
