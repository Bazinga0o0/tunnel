package templates

import "time"

type ReservationRow struct {
	Subdomain string
	CreatedAt time.Time
}

type ReservationsData struct {
	Rows      []ReservationRow
	ErrMsg    string
	Domain    string // e.g. "tunnel.localhost" — shown as "<sub>.<Domain>"
	CSRFToken string
	CSPNonce  string
}

templ ReservationsPage(data ReservationsData) {
	@Layout("Reservations", data.CSPNonce) {
		<main class="mx-auto max-w-4xl px-6 py-12">
			<header class="mb-8 flex items-center justify-between">
				<h1 class="text-2xl font-semibold">Reserved subdomains</h1>
				<a href="/dashboard" class="text-sm underline">← Dashboard</a>
			</header>
			if data.ErrMsg != "" {
				<div id="reservation-error" class="mb-4 rounded bg-red-100 px-4 py-3 text-sm text-red-800">{ data.ErrMsg }</div>
			} else {
				<div id="reservation-error"></div>
			}
			<form hx-post="/reservations" hx-target="#reservations-body" hx-swap="afterbegin" class="mb-6 flex items-end gap-3">
				<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
				<label class="flex-1">
					<span class="text-sm font-medium">Subdomain</span>
					<input type="text" name="subdomain" required pattern="[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])?" placeholder="e.g. myapp" class="mt-1 block w-full rounded border-zinc-300 px-3 py-2 font-mono"/>
				</label>
				<button type="submit" class="rounded bg-zinc-900 px-4 py-2 text-white hover:bg-zinc-800">Reserve</button>
			</form>
			<table class="w-full text-left text-sm">
				<thead class="border-b border-zinc-200 text-xs uppercase text-zinc-500">
					<tr>
						<th class="py-2">Subdomain</th>
						<th class="py-2">Reserved</th>
						<th class="py-2"></th>
					</tr>
				</thead>
				<tbody id="reservations-body">
					for _, r := range data.Rows {
						@ReservationsRow(r, data.Domain, data.CSRFToken)
					}
					if len(data.Rows) == 0 {
						<tr><td colspan="3" class="py-6 text-center text-zinc-500">No reservations yet.</td></tr>
					}
				</tbody>
			</table>
		</main>
	}
}

templ ReservationsRow(r ReservationRow, domain, csrfToken string) {
	<tr class="border-b border-zinc-100">
		<td class="py-2 font-mono">{ r.Subdomain }.{ domain }</td>
		<td class="py-2 text-zinc-600">{ r.CreatedAt.Format("Jan 2, 2006") }</td>
		<td class="py-2 text-right">
			<button
				hx-post={ "/reservations/" + r.Subdomain + "/release" }
				hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` }
				hx-target="closest tr"
				hx-swap="outerHTML"
				hx-confirm={ "Release " + r.Subdomain + "?" }
				class="text-red-700 hover:underline">
				Release
			</button>
		</td>
	</tr>
}

// ReservationsError replaces the error field of the reservation form out of
// band. An empty message clears it.
templ ReservationsError(msg string) {
	if msg == "" {
		<div id="reservation-error" hx-swap-oob="outerHTML"></div>
	} else {
		<div id="reservation-error" hx-swap-oob="outerHTML" class="mb-4 rounded bg-red-100 px-4 py-3 text-sm text-red-800">{ msg }</div>
	}
}
