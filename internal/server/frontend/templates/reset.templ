package templates

type ResetData struct {
	Token     string
	CSRFToken string
	CSPNonce  string
	ErrMsg    string
}

templ ResetPage(data ResetData) {
	@Layout("Reset password", data.CSPNonce) {
		<main class="mx-auto max-w-md px-6 py-12">
			<h1 class="text-2xl font-semibold mb-6">Set a new password</h1>
			if data.ErrMsg != "" {
				<div class="mb-4 rounded bg-red-100 px-4 py-3 text-sm text-red-800">{ data.ErrMsg }</div>
			}
			<form method="post" action="/reset" class="space-y-4">
				<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
				<input type="hidden" name="token" value={ data.Token }/>
				<label class="block">
					<span class="text-sm font-medium">New password</span>
					<input type="password" name="new" required minlength="8" class="mt-1 block w-full rounded border-zinc-300 px-3 py-2"/>
				</label>
				<label class="block">
					<span class="text-sm font-medium">Confirm new password</span>
					<input type="password" name="confirm" required minlength="8" class="mt-1 block w-full rounded border-zinc-300 px-3 py-2"/>
				</label>
				<button type="submit" class="w-full rounded bg-zinc-900 px-4 py-2 text-white hover:bg-zinc-800">Update password</button>
			</form>
		</main>
	}
}
