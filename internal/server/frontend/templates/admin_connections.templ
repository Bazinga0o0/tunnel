package templates

import (
	"fmt"
	"net/url"
	"time"
)

// ConnectionRow is the view model for one row in the connections table.
type ConnectionRow struct {
	SessionID   string
	Type        string // "http", "tcp", "udp", or "session" (no tunnel)
	Key         string // subdomain or ":port"; empty for "session"
	OwnerEmail  string
	ConnectedAt time.Time
}

// AdminConnectionsData is the view model for /admin/connections.
type AdminConnectionsData struct {
	CSPNonce  string
	CSRFToken string
}

// AdminConnectionsTableData is the view model for the polled fragment.
type AdminConnectionsTableData struct {
	Rows      []ConnectionRow
	Total     int // number of connections; more than len(Rows) when the list was cut
	Now       time.Time
	CSRFToken string
}

templ AdminConnectionsPage(data AdminConnectionsData) {
	@AdminLayout("Connections", data.CSPNonce, "connections") {
		<main class="mx-auto max-w-5xl px-6 py-12">
			<h1 class="text-2xl font-semibold mb-6">Live connections</h1>
			<input type="hidden" name="gorilla.csrf.Token" value={ data.CSRFToken }/>
			<div
				id="connections-table"
				hx-get="/admin/connections/status"
				hx-trigger="load, every 3s"
				hx-swap="innerHTML">
				<p class="text-zinc-500">Loading&#x2026;</p>
			</div>
		</main>
	}
}

templ AdminConnectionsTable(data AdminConnectionsTableData) {
	if len(data.Rows) == 0 {
		<p class="text-zinc-500 text-sm">No active tunnel connections right now.</p>
	} else {
		if data.Total > len(data.Rows) {
			<p class="mb-2 text-sm text-zinc-500">{ fmt.Sprintf("Showing the newest %d of %d connections.", len(data.Rows), data.Total) }</p>
		}
		<table class="w-full text-left text-sm border border-zinc-200 rounded bg-white">
			<thead class="bg-zinc-50 text-xs uppercase text-zinc-500">
				<tr>
					<th class="px-4 py-2 font-medium">Type</th>
					<th class="px-4 py-2 font-medium">Key</th>
					<th class="px-4 py-2 font-medium">Owner</th>
					<th class="px-4 py-2 font-medium">Connected</th>
					<th class="px-4 py-2"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-zinc-100">
				for _, row := range data.Rows {
					@AdminConnectionsRow(row, data.Now, data.CSRFToken)
				}
			</tbody>
		</table>
	}
}

templ AdminConnectionsRow(row ConnectionRow, now time.Time, csrfToken string) {
	<tr id={ "conn-" + row.SessionID }>
		<td class="px-4 py-2">
			<span class={ connTypeBadgeClass(row.Type) }>{ row.Type }</span>
		</td>
		<td class="px-4 py-2 font-mono text-xs">
			if row.Key == "" {
				<span class="text-zinc-400">—</span>
			} else {
				{ row.Key }
			}
		</td>
		<td class="px-4 py-2 font-mono text-xs">{ row.OwnerEmail }</td>
		<td class="px-4 py-2 text-zinc-600">{ formatUptime(now.Sub(row.ConnectedAt)) }</td>
		<td class="px-4 py-2 text-right">
			<form
				method="POST"
				action={ templ.SafeURL(connectionKillURL(row.SessionID)) }
				hx-post={ connectionKillURL(row.SessionID) }
				hx-target="closest tr"
				hx-swap="outerHTML"
				hx-headers={ fmt.Sprintf(`{"X-CSRF-Token": "%s"}`, csrfToken) }>
				<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
				<button type="submit" class="text-xs text-red-600 hover:underline">Kill</button>
			</form>
		</td>
	</tr>
}

// connectionKillURL is the kill URL of a session, with the session ID
// path-escaped.
func connectionKillURL(sessionID string) string {
	return "/admin/connections/" + url.PathEscape(sessionID) + "/kill"
}

func connTypeBadgeClass(t string) string {
	switch t {
	case "tcp":
		return "rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-800"
	case "udp":
		return "rounded-full bg-purple-100 px-2 py-0.5 text-xs text-purple-800"
	case "session":
		return "rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700"
	default:
		return "rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800"
	}
}
