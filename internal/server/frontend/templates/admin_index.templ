package templates

import "fmt"

// AdminIndexData is the view model for the admin overview page.
type AdminIndexData struct {
	UserCount     int64
	AdminCount    int64
	ActiveTunnels int
	SubdomainResv int64
	TCPPortResv   int64
	UDPPortResv   int64
	CSPNonce      string
}

templ AdminIndexPage(data AdminIndexData) {
	@AdminLayout("Admin", data.CSPNonce, "index") {
		<main class="mx-auto max-w-4xl px-6 py-12">
			<h1 class="text-2xl font-semibold mb-6">Admin overview</h1>
			<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
				@adminStatCard("Total users", fmt.Sprint(data.UserCount), "/admin/users")
				@adminStatCard("Admins", fmt.Sprint(data.AdminCount), "/admin/users")
				@adminStatCard("Active tunnels", fmt.Sprint(data.ActiveTunnels), "/admin/connections")
				@adminStatCard("Subdomain reservations", fmt.Sprint(data.SubdomainResv), "/admin/reservations?tab=subdomain")
				@adminStatCard("TCP port reservations", fmt.Sprint(data.TCPPortResv), "/admin/reservations?tab=tcp")
				@adminStatCard("UDP port reservations", fmt.Sprint(data.UDPPortResv), "/admin/reservations?tab=udp")
			</div>
		</main>
	}
}

templ adminStatCard(label, value, href string) {
	<a href={ templ.SafeURL(href) } class="block rounded border border-zinc-200 bg-white p-5 transition hover:border-zinc-400 hover:shadow-sm">
		<div class="text-sm font-medium text-zinc-600">{ label }</div>
		<div class="mt-2 text-3xl font-semibold">{ value }</div>
	</a>
}
